+  const signature = [stat.size, stat.mtimeMs, stat.ctimeMs, stat.ino].join(":")
+  const cached = readTokens.get(filename)
+  if (cached && cached.signature === signature) {
+    readTokens.delete(filename)
+    readTokens.set(filename, cached)
+    return cached.token
+  }
+  return rememberRead(filename, ts.sys.readFile(filename), stat)
+}
+
+function inputToken(value) {
+  if (Array.isArray(value)) return JSON.stringify(value.map(portable))
+  if (typeof value === "string") return portable(value)
+  return value
+}
+
+function inputsMatch(inputs) {
+  return inputs.every(input => {
+    const args = input.args.map((arg, i) =>
+      input.undefinedArgs.includes(i) ? undefined : arg
+    )
+    args[0] = path.resolve(args[0])
+    const token = input.method === "readFile"
+      ? readToken(args[0])
+      : inputToken(ts.sys[input.method](...args))
+    return token === input.token
+  })
+}
+
+function compile(code, lang, settings, runTwoSlash) {
+  const inputs = new Map()
+  const sys = { ...ts.sys }
+  // Misses and directory probes matter when new typings become available.
+  for (const method of [
+    "readFile", "fileExists", "directoryExists", "getDirectories",
+    "readDirectory", "realpath", "resolvePath",
+  ]) {
+    if (!ts.sys[method]) continue
+    sys[method] = (...args) => {
+      const value = ts.sys[method](...args)
+      const input = {
+        method,
+        args: args.map((arg, i) => i === 0 ? portable(path.resolve(arg)) : arg),
+        undefinedArgs: args.flatMap((arg, i) => arg === undefined ? [i] : []),
+      }
+      const key = JSON.stringify(input)
+      input.token = method === "readFile"
+        ? rememberRead(args[0], value, fs.statSync(args[0], { throwIfNoEntry: false }))
+        : inputToken(value)
+      inputs.set(key, input)
+      return value
+    }
+  }
+  const options = { ...settings, tsModule: { ...ts, sys } }
+  const results = runTwoSlash(code, lang, options)
+  return { results, inputs: [...inputs.values()] }
+}
+
+function cacheDirectory() {
+  if (process.versions.pnp) {
+    const pnp = require("pnpapi")
+    return path.join(
+      pnp.getPackageInformation(pnp.topLevel).packageLocation,
+      "node_modules", ".cache", "twoslash"
+    )
+  }
+  return __dirname.includes("node_modules")
+    ? path.join(__dirname.split("node_modules")[0], "node_modules", ".cache", "twoslash")
+    : path.join(__dirname, "..", "..", ".cache", "twoslash")
+}
+
+module.exports = function cachedTwoslash(code, lang, settings, runTwoSlash) {
+  if (settings.tsModule || settings.fsMap || settings.customTransformers || settings.lzstringModule) {
+    if (process.env.debug) console.log("Skipping Twoslash cache for custom compiler inputs")
+    return runTwoSlash(code, lang, settings)
+  }
+  const key = digest(JSON.stringify([code, lang, settings, compilerImplementation()]))
+  const directory = cacheDirectory()
+  const filename = path.join(directory, key + ".json")
+  if (fs.existsSync(filename)) {
+    const cached = JSON.parse(fs.readFileSync(filename, "utf8"))
+    if (inputsMatch(cached.inputs)) {
+      if (process.env.debug) console.log("Using cached twoslash results from " + filename)
+      const now = new Date()
+      fs.utimesSync(filename, now, now)
+      return cached.results
+    }
+  }
+  const cached = compile(code, lang, settings, runTwoSlash)
+  fs.mkdirSync(directory, { recursive: true })
+  fs.writeFileSync(filename, JSON.stringify(cached), "utf8")
+  return cached.results
+}
