          "type": "text",
          "text": " code samples."
        },
        {
          "type": "text",
          "text": "There are 3 main uses for TypeScript VFS:"
        },
        {
          "type": "text",
          "text": "Creating a TypeScript Program as an entry-point to the compiler API"
        },
        {
          "type": "text",
          "text": "Running TypeScript to emit files like "
        },
        {
          "type": "text",
          "text": "*.js"
        },
        {
          "type": "text",
          "text": ", "
        },
        {
          "type": "text",
          "text": "*.d.ts"
        },
        {
          "type": "text",
          "text": " or "
        },
        {
          "type": "text",
          "text": "*.map"
        },
        {
          "type": "text",
          "text": "Using TypeScript's language service to make the same calls an editor would make"
        },
        {
          "type": "text",
          "text": "You can learn more in the "
        },
        {
          "type": "link",
          "href": "https://github.com/microsoft/TypeScript-Website/blob/v2/packages/typescript-vfs/"
        },
        {
          "type": "text",
          "text": "TypeScript VFS README"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Setup with TypeScript from node_modules"
        },
        {
          "type": "code",
          "twoslash": false,
          "text": " import ts from 'typescript'\nimport tsvfs from '@typescript/vfs'\n\nconst fsMap = tsvfs.createDefaultMapFromNodeModules({ target: ts.ScriptTarget.ES2015 })\nfsMap.set('index.ts', 'console.log(\"Hello World\")')\n\n// ....\n               "
        },
        {
          "type": "heading",
          "level": 3,
          "text": "Use the TypeScript CDN to get your lib.d.ts files"
        },
        {
          "type": "code",
          "twoslash": false,
          "text": " import ts from 'typescript'\nimport tsvfs from '@typescript/vfs'\n\nconst fsMap = await tsvfs.createDefaultMapFromCDN(compilerOptions, ts.version, true, ts)\nfsMap.set('index.ts', 'console.log(\"Hello World\")')\n\nconst system = tsvfs.createSystem(fsMap)\nconst host = tsvfs.createVirtualCompilerHost(system, compilerOptions, ts)\n\nconst program = ts.createProgram({\n  rootNames: [...fsMap.keys()],\n  options: compilerOptions,\n  host: host.compilerHost,\n})\n\n// This will update the fsMap with new files\n// for the .d.ts and .js files\nprogram.emit()\n\n// Now I can look at the AST for the .ts file too\nconst index = program.getSourceFile('index.ts')\n               "
        }
