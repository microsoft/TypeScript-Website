---
import { getHomePageContent } from "../lib/root-pages.mjs"

interface Props { locale: string }
const { locale } = Astro.props
const text = getHomePageContent(locale)
const prefix = locale === "en" ? "" : `/${locale}`
type HomeFeature = { title: string; bodyHtml: string }
type HomeCard = { title: string; body: string; href: string }
const cards: HomeCard[] = text.startedCards
---
<div id="index-2">
  <section class="blue headline"><div class="container hero-grid">
    <div class="hero-copy">
      <h1 set:html={text.headingHtml}></h1>
      <p>{text.summary}</p>
      <a class="fluid-button" href={`${prefix}/download`}><span><strong>{text.installCta}</strong><small>Get started with TypeScript</small></span><b aria-hidden="true">•••</b></a>
    </div>
    <div class="headline-diagram" aria-label="TypeScript editor example">
      <div class="editor-tabs"><span class="selected">index.ts</span><span>index.js</span></div>
      <pre><code><span class="kw">interface</span> User {'{'}
  name: <span class="type">string</span>
  id: <span class="type">number</span>
{'}'}

<span class="kw">const</span> user: User = {'{'}
  name: <span class="str">"Ada"</span>,
  id: <span class="num">1</span>
{'}'}

console.log(user.name)</code></pre>
    </div>
  </div></section>

  <div class="version-bar"><p><a href="https://devblogs.microsoft.com/typescript/announcing-typescript-5-9/">TypeScript 5.9</a> is now available</p></div>

  <section class="white"><div class="container"><h2>{text.whatIs}</h2><div class="row features">
    {text.features.map((feature: HomeFeature) => <article class="col"><h3>{feature.title}</h3><p set:html={feature.bodyHtml}></p></article>)}
  </div></div></section>

  <section class="light-grey get-started-section"><div class="container"><h2 id="get_started">Get Started</h2><div class="row card-row">
    {cards.map((card, index) => <a class={`get-started tall art-${index}`} href={`${prefix}${card.href}`}><span><strong>{card.title}</strong><small>{card.body}</small></span><b aria-hidden="true">›</b></a>)}
  </div></div></section>

  <section class="white adopt"><div class="container narrow"><h2>Adopt TypeScript Gradually</h2><div class="row adopt-copy"><p>Apply types to your JavaScript project incrementally. TypeScript understands JavaScript and lets you introduce safety at your own pace.</p><p>Start by checking existing files, then rename them as your codebase becomes ready.</p></div><div class="steps"><div><b>1</b><code>npm install typescript</code></div><i>→</i><div><b>2</b><code>checkJs: true</code></div><i>→</i><div><b>3</b><code>allowJs: true</code></div><i>→</i><div><b>4</b><code>strict: true</code></div></div></div></section>

  <section class="light-grey"><div class="container"><div class="row code-row"><article><h3 id="describe-your-data">{text.describeTitle}</h3><p set:html={text.describeBodyHtml}></p></article><pre><code><span class="kw">interface</span> User {'{'}
  name: <span class="type">string</span>
  id: <span class="type">number</span>
{'}'}</code></pre><pre><code><span class="kw">const</span> user: User = {'{'}
  name: <span class="str">"Hayes"</span>,
  id: <span class="num">0</span>
{'}'}</code></pre></div></div></section>

  <section class="white via-delete"><div class="container"><h2 id="via-delete-key">JavaScript with syntax for types.</h2><div class="row code-row"><article><pre><code><span class="kw">function</span> greet(person: <span class="type">string</span>) {'{'}
  return `Hello ${'{'}person{'}'}`
{'}'}</code></pre><p>TypeScript adds natural syntax for providing types.</p></article><article><pre><code><span class="kw">function</span> greet(person) {'{'}
  return `Hello ${'{'}person{'}'}`
{'}'}</code></pre><p>Remove the types and your code is valid JavaScript.</p></article><article><pre><code>greet(<span class="str">"World"</span>)</code></pre><p>That JavaScript runs anywhere JavaScript runs.</p></article></div></div></section>

  <section class="light-grey migrations"><div class="container"><h2>TypeScript at Scale</h2><blockquote>“TypeScript has helped us scale our codebase and our engineering teams.”</blockquote><div class="company-row"><strong>Slack</strong><strong>Airbnb</strong><strong>Bloomberg</strong><strong>Microsoft</strong><strong>Google</strong></div></div></section>

  <section class="white loved"><div class="container"><h2>Loved by Developers</h2><div class="row survey-row"><article><img src="/images/index/stack-overflow.svg" alt="Stack Overflow survey showing TypeScript as a popular language"/><p>TypeScript is consistently ranked among the <strong>most loved programming languages</strong>.</p></article><article><img src="/images/index/state-of-js.svg" alt="State of JS survey logo"/><p>Developers say they would like to use TypeScript again in future projects.</p></article></div></div></section>

  <section class="blue get-started-section"><div class="container"><h2>Get Started</h2><div class="row card-row">
    {cards.map((card, index) => <a class={`get-started short art-${index}`} href={`${prefix}${card.href}`}><span><strong>{card.title}</strong><small>{card.body}</small></span><b aria-hidden="true">›</b></a>)}
  </div></div></section>
</div>

<style lang="scss">
  #index-2 { color: #111; }
  section > .container { box-sizing: border-box; display: flex; flex-direction: column; margin: 0 auto; max-width: 1080px; padding: 64px 20px 40px; position: relative; }
  .blue { background: #3178c6; color: white; }
  .white { background: white; }
  .light-grey { background: #f1f1f1; }
  h1 { font-size: 2.5rem; font-weight: 200; line-height: 1.12; margin: 0 0 1.5rem; }
  h1 :global(strong) { font-weight: 600; }
  h2 { font-size: 2.5rem; font-weight: 500; line-height: 1; margin: 0 0 3rem; text-align: center; }
  h3 { font-size: 1.6rem; font-weight: 400; line-height: 1; margin: 0 0 2.5rem; }
  p { font-size: 1.2rem; line-height: 1.55; }
  .row { display: flex; gap: 52px; }
  .hero-grid { flex-direction: row; gap: 60px; min-height: 420px; padding-bottom: 0; }
  .hero-copy { flex: 1; padding: 28px 0 48px; }
  .headline-diagram { align-self: end; background: #235a97; border: 2px solid #7fa2c9; border-radius: 8px; box-sizing: border-box; flex: 1; margin-bottom: 32px; min-height: 330px; overflow: hidden; }
  .editor-tabs { border-bottom: 1px solid #7fa2c9; display: flex; gap: 6px; padding: 0 8px; }
  .editor-tabs span { color: #d8e8fa; font-size: 14px; padding: 10px; }
  .editor-tabs .selected { text-decoration: underline; }
  pre { background: #fff; border: 1px solid #aaa; border-radius: 0; box-sizing: border-box; color: #1f1f1f; font: 15px/1.5 var(--code-font, Consolas, monospace); margin: 0; overflow: auto; padding: 24px; }
  .headline-diagram pre { background: #235a97; border: 0; color: white; min-height: 288px; }
  .kw { color: #7f167f; } .type { color: #00695c; } .str { color: #a31515; } .num { color: #2b579a; }
  .headline-diagram .kw { color: #f5c9f5; } .headline-diagram .type { color: #b8f0ea; } .headline-diagram .str { color: #ffd5c9; } .headline-diagram .num { color: #e0f7bc; }
  .fluid-button, .get-started { align-items: center; background: white; color: #111; display: flex; justify-content: space-between; text-decoration: none; }
  .fluid-button { box-shadow: 0 4px 20px -6px #0006; margin-top: 34px; max-width: 265px; padding: 16px; }
  .fluid-button span, .get-started span { display: flex; flex-direction: column; gap: 5px; }
  .fluid-button small, .get-started small { font-size: .9rem; }
  .version-bar { background: #262626; color: white; padding: .7rem 2rem; text-align: center; }
  .version-bar p { font-size: 1rem; margin: 0; } .version-bar a { color: #9cdcfe; }
  .features .col { flex: 1; min-width: 0; } .features h3 { text-align: center; }
  .card-row { justify-content: space-around; }
  .get-started { background-position: center bottom; background-repeat: no-repeat; box-shadow: 0 4px 20px -6px #0004; box-sizing: border-box; flex: 0 1 244px; outline: 1px solid #111; padding: 20px; }
  .get-started b { font-size: 2rem; }
  .get-started.tall { align-items: flex-start; height: 342px; }
  .get-started.tall.art-0 { background: white linear-gradient(145deg, transparent 55%, #b6d8f6 55% 67%, #3178c6 67%); }
  .get-started.tall.art-1 { background: white linear-gradient(155deg, transparent 52%, #f4c95d 52% 64%, #3178c6 64%); }
  .get-started.tall.art-2 { background: white linear-gradient(145deg, transparent 52%, #ddd 52% 63%, #555 63%); }
  .narrow { max-width: 780px !important; }
  .adopt-copy p { flex: 1; }
  .steps { align-items: center; display: flex; justify-content: space-between; margin: 45px 0 20px; }
  .steps div { align-items: center; display: flex; flex-direction: column; gap: 12px; } .steps b { align-items: center; background: #3178c6; border-radius: 50%; color: white; display: flex; height: 44px; justify-content: center; width: 44px; }
  .code-row > * { flex: 1; min-width: 0; } .code-row pre { min-height: 190px; }
  .via-delete article { flex: 1; min-width: 0; } .via-delete pre { min-height: 165px; }
  .migrations { overflow: hidden; } blockquote { background: #086e12; color: white; font-size: 1.7rem; margin: 0 auto 38px; max-width: 650px; padding: 40px; text-align: center; }
  .company-row { display: flex; font-size: 1.2rem; justify-content: space-around; }
  .survey-row article { align-items: center; display: flex; flex: 1; gap: 28px; } .survey-row img { max-height: 180px; max-width: 48%; }
  .get-started.short { background-color: #3178c6; color: white; height: 260px; outline-color: white; }
  .get-started.short.art-0 { background-image: linear-gradient(145deg, transparent 45%, #b6d8f6 45% 58%, #235a97 58%); }
  .get-started.short.art-1 { background-image: linear-gradient(155deg, transparent 45%, #f4c95d 45% 58%, #235a97 58%); }
  .get-started.short.art-2 { background-image: linear-gradient(145deg, transparent 45%, #aaa 45% 58%, #235a97 58%); }
  @media (max-width: 900px) {
    section > .container { padding: 48px 20px 38px; }
    h2 { font-size: 1.8rem; }
    .row, .hero-grid { flex-direction: column; gap: 28px; }
    .hero-grid { min-height: 0; }
    .hero-copy { padding: 5px 0 0; }
    .headline-diagram { align-self: stretch; margin: 0; min-height: 400px; }
    .card-row { align-items: center; } .get-started { flex-basis: auto; height: auto !important; max-width: 80%; min-height: 100px; width: 100%; }
    .steps { align-items: stretch; flex-direction: column; gap: 12px; } .steps i { text-align: center; transform: rotate(90deg); }
    .code-row pre { width: 100%; }
    .company-row { flex-wrap: wrap; gap: 24px; }
    .survey-row article { flex-direction: column; } .survey-row img { max-width: 100%; }
  }
</style>
