---
import DocumentationSidebarItem from "./DocumentationSidebarItem.astro"

interface NavItem { pathname?: string; title: string; current?: boolean; items?: NavItem[] }
interface NavGroup { title: string; items: NavItem[] }
interface Heading { depth: number; id: string; title: string }
interface LinkPage { pathname: string; title: string; description?: string }
interface Props {
  title: string
  rendered: string
  navigation: NavGroup[]
  headings: Heading[]
  previous?: LinkPage
  next?: LinkPage
  frontmatter?: Record<string, any>
  repoPath?: string
  modifiedTime?: string
  attribution?: { top: Array<{ name: string; gravatar: string; count: number }>; total: number } | null
}

interface HeadingTree extends Heading { children?: HeadingTree[] }

const { title, rendered, navigation, headings, previous, next, frontmatter = {}, repoPath, modifiedTime, attribution } = Astro.props
const lastEdited = modifiedTime ? new Intl.DateTimeFormat("en", { year: "numeric", month: "short", day: "2-digit" }).format(new Date(modifiedTime)) : undefined

const buildHeadingTree = (source: Heading[]): HeadingTree[] => {
  const root = []
  const stack = []

  for (const heading of source) {
    const node: HeadingTree = { ...heading }
    while (stack.length && stack[stack.length - 1].depth >= heading.depth) stack.pop()
    if (stack.length) {
      const parent = stack[stack.length - 1]
      parent.children = parent.children || []
      parent.children.push(node)
    } else {
      root.push(node)
    }
    stack.push(node)
  }

  return root
}

const headingTree = buildHeadingTree(headings)
---
<section id="doc-layout">
  <button id="sidebar-toggle" type="button" aria-label="Toggle sidebar navigation" aria-controls="sidebar" aria-expanded="false"><span aria-hidden="true">☰</span></button>
  <nav id="sidebar" aria-label="Documentation" tabindex="-1">
    <ul>{navigation.map(group => <DocumentationSidebarItem item={group} />)}</ul>
  </nav>
  <div id="handbook-content" role="article">
    {frontmatter.deprecated_by && <aside class="notice"><strong>This page has been deprecated.</strong> See <a href={frontmatter.deprecated_by}>the replacement documentation</a>.</aside>}
    {frontmatter.experimental && <aside class="notice"><strong>This page documents an experimental feature.</strong> Details may change.</aside>}
    <h1>{title}</h1>
    {frontmatter.preamble && <div class="preamble" set:html={frontmatter.preamble} />}
    <article>
      <div class="whitespace raised"><div class="markdown" set:html={rendered} /></div>
      {frontmatter.disable_toc !== true && headingTree.length > 0 && <aside class="handbook-toc"><nav aria-label="Table of contents"><h5>On this page</h5><ul>{headingTree.map((heading: HeadingTree) => <Fragment>
        <li class={`depth-${heading.depth}`}><a href={`#${heading.id}`}>{heading.title}</a>{heading.children?.length ? <ul>{heading.children.map((child: HeadingTree) => <li class={`depth-${child.depth}`}><a href={`#${child.id}`}>{child.title}</a></li>)}</ul> : undefined}</li>
      </Fragment>)}</ul><div id="like-dislike-subnav" role="status" aria-live="polite"><h5>Was this page helpful?</h5><div><button type="button" data-feedback="like" title="Like this page">Yes</button><button type="button" data-feedback="dislike" title="Dislike this page">No</button></div></div></nav></aside>}
    </article>
    {(previous || next) && <nav class="whitespace-tight raised page-navigation" aria-label="Previous and next pages">
      <div class="navigation-row">
        {previous ? <a class="navigation-link" rel="prev" href={`/${previous.pathname}`}><span class="page-link prev"><span class="arrow" aria-hidden="true">◀</span><span class="nav-content"><small>Previous</small><strong>{previous.title}</strong>{previous.description && <span>{previous.description}</span>}</span></span></a> : <span class="navigation-link" />}
        <span class="vertical-line" aria-hidden="true" />
        {next ? <a class="navigation-link" rel="next" href={`/${next.pathname}`}><span class="page-link next"><span class="arrow" aria-hidden="true">▶</span><span class="nav-content"><small>Next</small><strong>{next.title}</strong>{next.description && <span>{next.description}</span>}</span></span></a> : <span class="navigation-link" />}
      </div>
    </nav>}
    <footer class="whitespace-tight raised contributors">
      <div class="contributors-row">
        <section class="bottom-section-content"><p>The TypeScript docs are an open source project. Help us improve these pages {repoPath && <a href={`https://github.com/microsoft/TypeScript-Website/blob/v2/packages/${repoPath}`}>by sending a Pull Request</a>} ❤</p></section>
        <span class="vertical-line" aria-hidden="true" />
        <section class="bottom-section-content">Contributors to this page:<br /><div class="avatars">{attribution?.top?.map(person => <span class="circle-bg" title={`${person.name} (${person.count})`}>{person.name.split(" ").map(part => part[0]).join("").toUpperCase()}<img src={person.gravatar.startsWith("http") ? person.gravatar : `https://gravatar.com/avatar/${person.gravatar}?s=32&&d=blank`} alt={`${person.name} (${person.count})`} /></span>)}{attribution && attribution.total > attribution.top.length && <span class="circle-bg">{attribution.total - attribution.top.length}+</span>}</div></section>
        <span class="vertical-line" aria-hidden="true" />
        <section class="bottom-section-content"><p>{lastEdited && `Last updated: ${lastEdited}`}<br /><br /><span aria-hidden="true">&nbsp;</span></p></section>
      </div>
    </footer>
  </div>
</section>
<script>
  const toggle = document.querySelector<HTMLButtonElement>("#sidebar-toggle")
  const sidebar = document.querySelector<HTMLElement>("#sidebar")
  sidebar?.querySelectorAll<HTMLButtonElement>("li > button").forEach(button => button.addEventListener("click", () => {
    const item = button.parentElement
    const open = !item?.classList.contains("open")
    item?.classList.toggle("open", open)
    item?.classList.toggle("closed", !open)
    button.setAttribute("aria-expanded", String(open))
  }))
  const setSidebar = (open: boolean) => {
    sidebar?.classList.toggle("open", open)
    if (sidebar) sidebar.inert = matchMedia("(max-width: 900px)").matches && !open
    toggle?.setAttribute("aria-expanded", String(open))
  }
  setSidebar(false)
  toggle?.addEventListener("click", () => {
    const open = !sidebar?.classList.contains("open")
    setSidebar(open)
    if (open) requestAnimationFrame(() => {
      const current = sidebar?.querySelector<HTMLAnchorElement>('a[aria-current="page"]')
      const visibleFallback = sidebar?.querySelector<HTMLAnchorElement>("li.open a")
      ;(current || visibleFallback)?.focus()
    })
  })
  addEventListener("keydown", event => {
    if (event.key === "Escape" && sidebar?.classList.contains("open")) { setSidebar(false); toggle?.focus(); return }
    if (!sidebar?.contains(document.activeElement) || !["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return
    const links = [...sidebar.querySelectorAll<HTMLAnchorElement>("a")]
    const index = links.indexOf(document.activeElement as HTMLAnchorElement)
    const target = event.key === "Home" ? links[0] : event.key === "End" ? links.at(-1) : event.key === "ArrowDown" ? links[index + 1] : links[index - 1]
    if (target) { event.preventDefault(); target.focus() }
  })
  matchMedia("(max-width: 900px)").addEventListener("change", () => setSidebar(false))
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>(".handbook-toc a")]
  const sections = tocLinks.map(link => document.querySelector<HTMLElement>(link.hash)).filter(Boolean) as HTMLElement[]
  const update = () => {
    let active = sections[0]
    for (const section of sections) if (section.getBoundingClientRect().top < 130) active = section
    for (const link of tocLinks) link.classList.toggle("current", link.hash === `#${active?.id}`)
  }
  addEventListener("scroll", update, { passive: true })
  update()
  const feedback = document.querySelector<HTMLElement>("#like-dislike-subnav")
  feedback?.addEventListener("click", event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-feedback]")
    if (!button || !feedback) return
    feedback.replaceChildren(Object.assign(document.createElement("p"), { textContent: "Thanks for the feedback" }))
  })
</script>
