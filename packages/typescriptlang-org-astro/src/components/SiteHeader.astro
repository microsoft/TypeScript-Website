---
import { createLocalizedHref } from "../lib/localization.mjs"
interface Props { lang: string; pathname: string; skipTo?: string; routePathnames: string[] }
const { lang, pathname, routePathnames, skipTo = "#site-content" } = Astro.props
const availablePaths = new Set(routePathnames)
const localized = (href: string) => createLocalizedHref(lang, href, availablePaths)
const nav = [
  ["Download", "/download", "nav-download"],
  ["Docs", "/docs/", ""],
  ["Handbook", "/docs/handbook/intro.html", "nav-handbook"],
  ["Community", "/community", "nav-community"],
  ["Playground", "/play/", "nav-playground"],
  ["Tools", "/tools", "nav-tools"],
]
---
<header dir="ltr">
  <a class="skip-to-main" href={skipTo}>Skip to main content</a>
  <div id="top-menu" class="up">
    <div class="top-left left below-small">
      <a id="home-page-logo" href={localized("/")} aria-label="TypeScript home page">
        <svg fill="none" height="26" viewBox="0 0 27 26" width="27" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path clip-rule="evenodd" d="m.98608 0h24.32332c.5446 0 .9861.436522.9861.975v24.05c0 .5385-.4415.975-.9861.975h-24.32332c-.544597 0-.98608-.4365-.98608-.975v-24.05c0-.538478.441483-.975.98608-.975zm13.63142 13.8324v-2.1324h-9.35841v2.1324h3.34111v9.4946h2.6598v-9.4946zm1.0604 9.2439c.4289.2162.9362.3784 1.5218.4865.5857.1081 1.2029.1622 1.8518.1622.6324 0 1.2331-.0595 1.8023-.1784.5691-.1189 1.0681-.3149 1.497-.5879s.7685-.6297 1.0187-1.0703.3753-.9852.3753-1.6339c0-.4703-.0715-.8824-.2145-1.2365-.1429-.3541-.3491-.669-.6186-.9447-.2694-.2757-.5925-.523-.9692-.7419s-.8014-.4257-1.2743-.6203c-.3465-.1406-.6572-.2771-.9321-.4095-.275-.1324-.5087-.2676-.7011-.4054-.1925-.1379-.3409-.2838-.4454-.4379-.1045-.154-.1567-.3284-.1567-.523 0-.1784.0467-.3392.1402-.4824.0935-.1433.2254-.2663.3959-.369s.3794-.1824.6269-.2392c.2474-.0567.5224-.0851.8248-.0851.22 0 .4523.0162.697.0486.2447.0325.4908.0825.7382.15.2475.0676.4881.1527.7218.2555.2337.1027.4495.2216.6475.3567v-2.4244c-.4015-.1514-.84-.2636-1.3157-.3365-.4756-.073-1.0214-.1095-1.6373-.1095-.6268 0-1.2207.0662-1.7816.1987-.5609.1324-1.0544.3392-1.4806.6203s-.763.6392-1.0104 1.0743c-.2475.4352-.3712.9555-.3712 1.5609 0 .7731.2268 1.4326.6805 1.9785.4537.546 1.1424 1.0082 2.0662 1.3866.363.146.7011.2892 1.0146.4298.3134.1405.5842.2865.8124.4378.2282.1514.4083.3162.5403.4946s.198.3811.198.6082c0 .1676-.0413.323-.1238.4662-.0825.1433-.2076.2676-.3753.373s-.3766.1879-.6268.2473c-.2502.0595-.5431.0892-.8785.0892-.5719 0-1.1383-.0986-1.6992-.2959-.5608-.1973-1.0805-.4933-1.5589-.8879z" fill="#fff" fill-rule="evenodd" /></svg><span class="hide-small">TypeScript</span>
      </a>
      <button id="top-menu-toggle" type="button" aria-controls="top-menu-links" aria-expanded="false">Menu</button>
      <nav class="top-nav" id="top-menu-links" aria-label="Top menu">
        <ul>{nav.map(([label, href, className], index) => <li class={`nav-item ${className}`}><a id={`tab${index + 1}`} href={localized(href)} aria-current={pathname === localized(href) ? "page" : undefined}>{label === "Docs" ? <span>{label}</span> : label}</a></li>)}</ul>
      </nav>
    </div>
    <div class="right above-small"><div class="search-section"><div id="my-lang-quick-jump" class="nav-item" style="display:none"><a href="">in En</a></div><div class="nav-item">
      <form class="search top-nav" id="search-form" role="search" action="/dt/search" data-docsearch-app-id="BGCDYOIYZ5" data-docsearch-api-key="37ee06fa68db6aef451a490df6df7c60" data-docsearch-index="typescriptlang">
        <svg fill="none" height="16" viewBox="0 0 16 16" width="16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="m10.5 0c.5052 0 .9922.0651042 1.4609.195312.4688.130209.9063.315105 1.3125.554688.4063.239583.7761.52865 1.1094.86719.3386.33333.6276.70312.8672 1.10937s.4245.84375.5547 1.3125.1953.95573.1953 1.46094-.0651.99219-.1953 1.46094-.3151.90625-.5547 1.3125-.5286.77864-.8672 1.11718c-.3333.33334-.7031.61978-1.1094.85938-.4062.2396-.8437.4245-1.3125.5547-.4687.1302-.9557.1953-1.4609.1953-.65104 0-1.27604-.1094-1.875-.3281-.59375-.2188-1.14062-.5339-1.64062-.94534l-6.132818 6.12504c-.098958.0989-.216145.1484-.351562.1484s-.252604-.0495-.351562-.1484c-.0989588-.099-.148438-.2162-.148438-.3516s.0494792-.2526.148438-.3516l6.125002-6.13278c-.41146-.5-.72656-1.04687-.94532-1.64062-.21874-.59896-.32812-1.22396-.32812-1.875 0-.50521.0651-.99219.19531-1.46094s.31511-.90625.55469-1.3125.52604-.77604.85938-1.10937c.33854-.33854.71093-.627607 1.11718-.86719s.84375-.424479 1.3125-.554688c.46875-.1302078.95573-.195312 1.46094-.195312zm0 10c.6198 0 1.2031-.11719 1.75-.35156.5469-.23959 1.0234-.5625 1.4297-.96875.4062-.40625.7265-.88281.9609-1.42969.2396-.54688.3594-1.13021.3594-1.75s-.1198-1.20312-.3594-1.75c-.2344-.54688-.5547-1.02344-.9609-1.42969-.4063-.40625-.8828-.72656-1.4297-.96093-.5469-.23959-1.1302-.35938-1.75-.35938-.61979 0-1.20312.11979-1.75.35938-.54688.23437-1.02344.55468-1.42969.96093s-.72916.88281-.96875 1.42969c-.23437.54688-.35156 1.13021-.35156 1.75s.11719 1.20312.35156 1.75c.23959.54688.5625 1.02344.96875 1.42969s.88281.72916 1.42969.96875c.54688.23437 1.13021.35156 1.75.35156z" fill="#fff" /></svg>
        <span><input id="search-box-top" name="q" type="search" placeholder="Search Docs" role="combobox" aria-label="Search the TypeScript site" autocomplete="off" aria-autocomplete="list" aria-controls="docsearch-results" aria-expanded="false" /></span>
        <div id="docsearch-results" role="listbox" aria-label="Search results" hidden></div>
      </form>
    </div></div></div>
  </div>
</header>
<script is:inline define:vars={{ routePathnames }}>
  (() => {
    const nav = document.getElementById("top-menu")
    const sideButton = document.getElementById("small-device-button-sidebar")
    let previousY = 9999
    const updateStickyNavigation = () => {
      const active = document.activeElement
      if (active && (active.nodeName === "INPUT" || active.nodeName === "TEXTAREA")) return
      const scrollingDown = window.pageYOffset > 1 && window.pageYOffset > previousY
      previousY = window.pageYOffset
      nav?.classList.toggle("down", scrollingDown)
      nav?.classList.toggle("up", !scrollingDown)
      sideButton?.classList.toggle("hidden", scrollingDown)
    }
    document.addEventListener("scroll", updateStickyNavigation, { capture: true, passive: true })

    const menuButton = document.getElementById("top-menu-toggle")
    const menu = document.getElementById("top-menu-links")
    const closeMenu = () => { menu?.classList.remove("open"); menuButton?.setAttribute("aria-expanded", "false") }
    menuButton?.addEventListener("click", () => {
      const open = !menu?.classList.contains("open")
      menu?.classList.toggle("open", open)
      menuButton.setAttribute("aria-expanded", String(open))
      if (open) menu?.querySelector("a")?.focus()
    })
    addEventListener("keydown", event => { if (event.key === "Escape") { closeMenu(); menuButton?.focus() } })

    const form = document.getElementById("search-form")
    const input = document.getElementById("search-box-top")
    const results = document.getElementById("docsearch-results")
    if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement) || !(results instanceof HTMLElement)) return
    const normalizeHit = hit => {
      if (!hit?.url) return hit
      try { const url = new URL(hit.url, location.origin); return { ...hit, url: `${location.origin}${url.pathname}${url.search}${url.hash}` } } catch { return hit }
    }
    const render = hits => {
      results.replaceChildren(...hits.slice(0, 8).map((hit, index) => {
        const anchor = document.createElement("a")
        anchor.href = normalizeHit(hit).url
        anchor.role = "option"
        anchor.id = `docsearch-option-${index}`
        anchor.textContent = hit.title || hit.hierarchy?.lvl1 || hit.url
        return anchor
      }))
      results.hidden = !hits.length
      input.setAttribute("aria-expanded", String(Boolean(hits.length)))
    }
    const fixture = window.__TS_DOCSEARCH_FIXTURE__
    if (Array.isArray(fixture)) {
      input.addEventListener("input", () => render(fixture.filter(hit => JSON.stringify(hit).toLowerCase().includes(input.value.toLowerCase()))))
    } else {
      const script = document.createElement("script")
      script.src = "https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.js"
      script.async = true
      const stylesheet = document.createElement("link")
      stylesheet.rel = "stylesheet"
      stylesheet.href = "https://cdn.jsdelivr.net/npm/docsearch.js@2/dist/cdn/docsearch.min.css"
      document.head.appendChild(stylesheet)
      script.onload = () => window.docsearch?.({
        appId: form.dataset.docsearchAppId,
        apiKey: form.dataset.docsearchApiKey,
        indexName: form.dataset.docsearchIndex,
        inputSelector: "#search-box-top",
        transformData: hits => hits.map(normalizeHit),
      })
      document.body.appendChild(script)
    }
    form.addEventListener("submit", event => {
      const first = results.querySelector("a")
      if (first) { event.preventDefault(); location.assign(first.href) }
      else if (input.value.trim()) { event.preventDefault(); location.assign(`/dt/search?q=${encodeURIComponent(input.value.trim())}`) }
    })
    input.addEventListener("keydown", event => {
      if (event.key === "ArrowDown") { event.preventDefault(); results.querySelector("a")?.focus() }
      if (event.key === "Escape") { render([]); input.blur() }
    })
    results.addEventListener("keydown", event => {
      const links = [...results.querySelectorAll("a")]
      const index = links.indexOf(document.activeElement)
      if (event.key === "ArrowDown") { event.preventDefault(); links[(index + 1) % links.length]?.focus() }
      if (event.key === "ArrowUp") { event.preventDefault(); (index <= 0 ? input : links[index - 1])?.focus() }
      if (event.key === "Escape") { render([]); input.focus() }
    })
  })()
</script>
