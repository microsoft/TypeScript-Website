---
import GatsbyDocumentParity from "../../components/GatsbyDocumentParity.astro"
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>TypeScriptをダウンロード</title></head><body><GatsbyDocumentParity page="downloadJa" /><script is:inline>
if (window.innerWidth >= 800 && !localStorage.getItem("dont-recommend-translate")) {
  const popup = document.getElementById("language-recommendation")
  if (popup) {
    popup.hidden = false
    popup.style.display = "block"
    const open = document.getElementById("language-recommendation-open")
    const dismiss = document.getElementById("language-recommendation-no-more")
    if (open) { open.textContent = "Consulter"; open.setAttribute("aria-label", "Consulter") }
    if (dismiss) { dismiss.textContent = "Ne plus me le rappeler"; dismiss.setAttribute("aria-label", "Ne plus me le rappeler") }
  }
}
</script></body></html>
